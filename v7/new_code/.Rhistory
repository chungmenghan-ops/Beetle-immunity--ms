geom_ribbon(data = lines,
aes(x = weight, ymin = lower.CL, ymax = upper.CL),
fill = "grey40", alpha = 0.3) +
geom_line(data = lines,
aes(x = weight, y = emmean),
colour = "black", linewidth = 1) +
