## Figure - body weight vs immune activity, by sex and offspring temp
library(emmeans)
# Offspring temperature colours (same as your other figures)
temp_cols <- c("ancestral" = "blue", "high" = "red")
weight_theme <- theme_classic() +
theme(
axis.line = element_blank(),
panel.border = element_rect(colour = "black",
fill = NA,
linewidth = 1),
legend.position = "none"
)
# Model-predicted lines for each offspring temperature
# (averaged over mum temp, dad temp and age; population-level, no family effect)
get_weight_line <- function(model) {
w <- model.frame(model)$weight
w_seq <- seq(min(w), max(w), length.out = 100)
emmeans(model, ~ weight | os_temp,
at = list(weight = w_seq),
lmer.df = "satterthwaite") %>%
as.data.frame()
}
# Plotting function: raw points + model lines, coloured by os_temp
plot_weight <- function(data, model, yvar, ylab, title) {
lines <- get_weight_line(model)
ggplot() +
geom_point(data = data,
aes(x = weight, y = .data[[yvar]], fill = os_temp),
shape = 21, colour = "black", stroke = 0.3, size = 1.5) +
geom_ribbon(data = lines,
aes(x = weight, ymin = lower.CL, ymax = upper.CL, fill = os_temp),
alpha = 0.2) +
geom_line(data = lines,
aes(x = weight, y = emmean, colour = os_temp),
linewidth = 1) +
scale_colour_manual(values = temp_cols) +
scale_fill_manual(values = alpha(temp_cols, 0.4)) +
labs(x = "body weight", y = ylab, title = title) +
weight_theme
}
####################
## PO activity    ##
####################
W_F_po <- plot_weight(female_po, F_model_po_3, "log_po_corrected",
"PO activity\n(log-transformed)", "Female")
W_M_po <- plot_weight(male_po, M_model_po_3, "log_po_corrected",
"PO activity\n(log-transformed)", "Male")
W_F_po
W_M_po
W_F_po
W_M_po
W_F_po
W_M_po
